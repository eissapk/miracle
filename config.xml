<?xml version='1.0' encoding='utf-8'?>
<widget id="xyz.eissa.miracle" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <icon src="www/img/logo.png" />
    <name>معجزة</name>
    <description>
        A quoran app named Miracle because the quoran itself is a mental miracle
    </description>
    <author email="eissapk44@gmail.com" href="https://eissa.xyz">
        Eissa Saber
    </author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="file://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />
    <preference name="DisallowOverscroll" value="true" />
    <preference name="SplashScreenDelay" value="10000" />
    <preference name="orientation" value="portrait" />
    
    <platform name="android">
        <preference name="android-minSdkVersion" value="22" />
        <preference name="android-targetSdkVersion" value="30" />
        <allow-intent href="market:*" />
        <preference name="scheme" value="app" />
        <preference name="hostname" value="localhost" />
        <!-- splash -->
        <splash src="www/img/splash/hdpi.png" density="port-hdpi" />
        <splash src="www/img/splash/ldpi.png" density="port-ldpi" />
        <splash src="www/img/splash/mdpi.png" density="port-mdpi" />
        <splash src="www/img/splash/xhdpi.png" density="port-xhdpi" />
        <splash src="www/img/splash/xxhdpi.png" density="port-xxhdpi" />
        <splash src="www/img/splash/xxxhdpi.png" density="port-xxxhdpi" />
    </platform>
    
    <platform name="ios">
        <allow-intent href="itms:*" />
        <allow-intent href="itms-apps:*" />
    </platform>
</widget>
